# Copy this file to .env and fill in the values below.

# Get this from @BotFather on Telegram after running /newbot
BOT_TOKEN=

# Your personal Telegram chat ID, so orders get sent to you.
# Leave blank the first time you run the bot, then send it the /myid
# command, copy the number it gives you, and put it here.
OWNER_CHAT_ID=
